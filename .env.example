# ===== AI 模型（首次启动时的默认值）=====
# 启动后可以直接在网页右上角「模型设置」里修改，以下配置只在还没有保存过
# cache/llm_settings.json 时作为初始值使用。
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_PROTOCOL=auto
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180
LLM_CONCURRENCY=3

# OpenCode Go 的官方环境变量名，二选一即可
OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=

# ===== 其他来源（可选）=====
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M2.7
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ===== 应用 =====
APP_HOST=127.0.0.1
APP_PORT=8000
# 设为 1 开启代码热重载
APP_RELOAD=0

# ===== 本地存档与录像解析 =====
# 0 = 永不清理，保留所有已分析比赛供后续复查；大于 0 时单位为秒
CACHE_TTL_SECONDS=0
CACHE_DIR=cache/matches
# 原始 OpenDota 数据（含录像解析字段）存档目录
RAW_CACHE_DIR=cache/raw
# 首次拉取未解析时，后台最多等待的时间和轮询间隔
PARSE_POLL_INTERVAL=10
PARSE_MAX_ATTEMPTS=30
